{
  "manifest_version": 3,
  "name": "The Economist Dark",
  "version": "2.2.0",
  "description": "Read economist.com in dark mode",
  "icons": {
    "16": "econ.png",
    "32": "econ.png",
    "48": "econ.png",
    "128": "econ.png"
  },
  "action": {
    "default_icon": "econ.png"
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "css": [
        "dark.css"
      ],
      "matches": [
        "https://economist.com/*",
        "https://www.economist.com/*"
      ],
      "exclude_matches": [
        "https://economist.com/interactive/*",
        "https://www.economist.com/interactive/*",
        "https://www.economist.com/insider/*"
      ],
      "run_at": "document_start"
    }
  ]
}
